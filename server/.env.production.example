# Production environment template - copy the VALUES into your platform's env-key UI
# (Render/Railway/Fly.io secret store). Never commit a real filled-in copy.
# The server refuses to boot in production with an unsafe combination of these
# (src/config/runtimeGuard.js), so an unfinished copy fails loudly in the deploy log.

NODE_ENV=production
PORT=10000                          # Render injects $PORT; most platforms let you name it
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/syncora?tls=true

# Deployed SPA origin, https only - drives CORS, socket Origin checks and cookie scope.
CLIENT_URL=https://app.example.com

# Generate fresh, never reuse a dev value:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Always set behind the platform's reverse proxy (1 hop) so per-IP rate limits see real clients.
TRUST_PROXY=1

# Real SMTP credentials are required for verification/reset emails to leave the console:
# the server prints them to its own log if SMTP_HOST is unset (warning at boot).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Syncora <no-reply@example.com>
